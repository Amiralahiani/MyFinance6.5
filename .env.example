# Never commit .env. Put the real value only in your local environment.
GROQ_API_KEY=

# Groq writes the final answer only from evidence selected by MyFinance.
MYFINANCE_LLM_PROVIDER=groq
MYFINANCE_USE_LLM=1
MYFINANCE_GROQ_MODEL=openai/gpt-oss-20b
# General Groq answers must cite a locally curated official source.
MYFINANCE_REQUIRE_GENERAL_SOURCES=1

# Optional per-agent overrides. Leave blank to use autotest/configs/autotest.yaml defaults.
GROQ_MODEL_GENERATOR=
GROQ_MODEL_PLANNER=
GROQ_MODEL_EVALUATOR=
GROQ_MODEL_CRITIC=
GROQ_MODEL_REPORTER=

# Independent local applications
CHAT_API_PORT=8000
CHAT_WEB_PORT=3000
TESTING_API_PORT=8001
TESTING_WEB_PORT=3001
CHAT_API_URL=http://127.0.0.1:8000
TESTING_API_URL=http://127.0.0.1:8001
TESTING_WEB_URL=http://127.0.0.1:3001

# Local is intentionally the default: Docker publishes services only on 127.0.0.1.
# A public deployment must use a reverse proxy with TLS and authentication, then set
# explicit origins and hosts. Never use `*` in production.
MYFINANCE_DEPLOYMENT_MODE=local
MYFINANCE_CORS_ORIGINS=
MYFINANCE_ALLOWED_HOSTS=
# 0 disables the in-process limiter locally. Production requires a non-zero value.
MYFINANCE_RATE_LIMIT_PER_MINUTE=0

# Optional hybrid RAG.  Lexical retrieval remains the safe fallback whenever
# Qdrant or the embeddings model is unavailable.
MYFINANCE_VECTOR_ENABLED=1
MYFINANCE_QDRANT_URL=http://127.0.0.1:6333
MYFINANCE_QDRANT_COLLECTION=myfinance_evidence
MYFINANCE_EMBEDDINGS_URL=http://127.0.0.1:11434/api/embed
MYFINANCE_EMBEDDING_MODEL=nomic-embed-text
MYFINANCE_OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Docker containers communicate with Ollama using its internal service name.
# Leave blank unless the Docker stack uses another embeddings endpoint.
MYFINANCE_DOCKER_EMBEDDINGS_URL=
